<Window
    x:Class="PublishDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    x:Name="RootWindow"
    Title="站点管理"
    Width="1200"
    Height="700"
    Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧  -->
        <Border
            Grid.Column="0"
            Padding="8"
            BorderBrush="#EEE"
            BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  工具栏（同一行）  -->
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">

                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="全选"
                        IsChecked="{Binding IsAllSelected}" />

                    <Button
                        Width="50"
                        Margin="0,0,6,0"
                        Command="{Binding AddCommand}"
                        Content="添加"
                        Style="{StaticResource ButtonPrimary}" />

                    <Button
                        Width="50"
                        Margin="0,0,6,0"
                        Command="{Binding PublishCommand}"
                        Content="发布"
                        Style="{StaticResource ButtonInfo}" />

                    <Button
                        Width="50"
                        Command="{Binding RefreshCommand}"
                        Content="刷新"
                        Style="{StaticResource ButtonDefault}" />
                </StackPanel>

                <!--  列表  -->
                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding Sites}"
                    SelectedItem="{Binding SelectedSite}">
                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <CheckBox Margin="0,0,8,0" IsChecked="{Binding IsSelected}" />

                                <TextBlock Text="{Binding Name}" />

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>
                    <ListBox.Resources>

                        <!--  编辑  -->
                        <ContextMenu x:Key="ItemMenu">

                            <MenuItem
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Header="编辑" />

                            <MenuItem
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Header="删除" />

                        </ContextMenu>

                    </ListBox.Resources>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">

                            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />

                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>

            </Grid>
        </Border>

        <!--  右侧  -->
        <!--  右侧  -->
        <Grid Grid.Column="1" Margin="10">

            <!--  30% + 70%  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <!--  ================= 上方 30%：站点详情 =================  -->
            <hc:Card Grid.Row="0" Padding="12">

                <!--  站点详情  -->
                <Border
                    Grid.Row="0"
                    Margin="10,0,0,10"
                    Padding="15"
                    CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  第一行  -->

                        <!--  名称  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,20,10">

                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="站点名称" />

                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding SelectedSite.Name}" />

                        </StackPanel>

                        <!--  状态  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,20,10">

                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="状态" />

                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#4CAF50"
                                Text="{Binding CurrentTask.Status}" />

                        </StackPanel>

                        <!--  第二行  -->

                        <!--  站点路径  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,20,10">

                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="站点路径" />

                            <TextBlock Text="{Binding SelectedSite.SitePath}" TextWrapping="Wrap" />

                        </StackPanel>

                        <!--  文件路径  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,20,10">

                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="文件路径" />

                            <TextBlock Text="{Binding SelectedSite.FilePath}" TextWrapping="Wrap" />

                        </StackPanel>


                    </Grid>

                </Border>

            </hc:Card>
            <hc:Card Grid.Row="1" Padding="12">

                <Border
                    Grid.Row="1"
                    Margin="10"
                    Padding="10"
                    CornerRadius="6">

                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="文件上传" />

                        <Button
                            Width="140"
                            Height="35"
                            Margin="0,0,0,10"
                            Command="{Binding UploadCommand}"
                            Content="选择ZIP文件并上传"
                            Style="{StaticResource ButtonPrimary}" />

                        <!--<TextBlock Foreground="#777" Text="支持拖拽上传（可后续加）" />-->

                    </StackPanel>

                </Border>
            </hc:Card>
            <!--  ================= 下方 70%：日志 + 进度 =================  -->
            <hc:Card
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  进度条  -->
                    <ProgressBar
                        Height="18"
                        Maximum="100"
                        Value="{Binding Progress}" />

                    <!--  日志  -->
                    <!--  日志区域  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="#2b2b2b"
                        CornerRadius="6">

                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding Logs}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Margin="0,2" Orientation="Horizontal">

                                            <!--  时间  -->
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                Foreground="#777"
                                                Text="{Binding Time, StringFormat=HH:mm:ss}" />

                                            <!--  类型  -->
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                FontWeight="Bold"
                                                Foreground="{Binding Foreground}"
                                                Text="{Binding LogType}" />

                                            <!--  消息  -->
                                            <TextBox
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{Binding Foreground}"
                                                IsReadOnly="True"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Border>
                    <!--  状态  -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Foreground="Gray"
                        Text="{Binding StatusText}" />

                </Grid>

            </hc:Card>

        </Grid>
    </Grid>
</Window>