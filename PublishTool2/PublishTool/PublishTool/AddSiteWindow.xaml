<Window
    x:Class="PublishTool.AddSiteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:PublishTool"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加站点"
    Width="500"
    Height="300"
    mc:Ignorable="d">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />

            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <!--  站点名称  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="站点名称：" />

        <hc:TextBox
            x:Name="txtName"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="36"
            Text="{Binding Name}" />



        <!--  站点地址  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="站点地址：" />

        <hc:TextBox
            x:Name="txtSitePath"
            Grid.Row="2"
            Grid.Column="1"
            Height="36"
            Margin="0,0,10,0"
            IsReadOnly="True"
            Text="{Binding SitePath}" />

        <Button
            Grid.Row="2"
            Grid.Column="2"
            Height="36"
            Click="Button_Click_1"
            Content="选择"
            Style="{StaticResource ButtonPrimary}" />



        <!--  文件地址  -->
        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="文件地址：" />

        <hc:TextBox
            x:Name="txtFilePath"
            Grid.Row="4"
            Grid.Column="1"
            Height="36"
            Margin="0,0,10,0"
            IsReadOnly="True"
            Text="{Binding FilePath}" />

        <Button
            Grid.Row="4"
            Grid.Column="2"
            Height="36"
            Click="Button_Click"
            Command="{Binding SelectPublishPathCommand}"
            Content="选择"
            Style="{StaticResource ButtonPrimary}" />



        <!--  保存按钮  -->
        <Button
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Width="120"
            Height="40"
            HorizontalAlignment="Center"
            Click="Button_Click_2"
            Command="{Binding SaveCommand}"
            Content="保存"
            Style="{StaticResource ButtonPrimary}" />

    </Grid>
</Window>
