<Window
    x:Class="PublishTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IIS 发布工具"
    Width="1100"
    Height="650"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧  -->
        <Grid Grid.Column="0" Background="#F7F7F7">


            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  顶部工具栏  -->
            <Border
                Grid.Row="0"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1">

                <StackPanel
                    Margin="10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        Width="70"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="AddSite_Click"
                        Content="添加站点"
                        Style="{StaticResource ButtonPrimary}" />

                    <Button
                        Width="70"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="BatchPublish_Click"
                        Content="批量发布"
                        Style="{StaticResource ButtonPrimary}" />

                    <CheckBox
                        VerticalAlignment="Center"
                        Checked="SelectAll_Checked"
                        Content="全选"
                        Unchecked="SelectAll_Unchecked" />

                </StackPanel>

            </Border>

            <ListBox
                x:Name="SiteListBox"
                Grid.Row="1"
                Margin="10"
                ItemsSource="{Binding SiteList}"
                SelectionChanged="SiteListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />

                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>

                        <MenuItem Click="EditSite_Click" Header="编辑" />

                        <MenuItem Click="DeleteSite_Click" Header="删除" />

                    </ContextMenu>
                </ListBox.ContextMenu>

            </ListBox>


        </Grid>

        <!--  分割线  -->
        <Border Grid.Column="1" Background="#DDDDDD" />

        <!--  右侧  -->
        <!--  右侧  -->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <!--  顶部工具栏  -->
                <RowDefinition Height="60" />

                <!--  配置区域  -->
                <RowDefinition Height="160" />

                <!--  日志区域  -->
                <RowDefinition Height="*" />

                <!--  底部进度  -->
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>

            <!--  顶部  -->
            <Border
                Grid.Row="0"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">

                <DockPanel Margin="15,10">

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding SelectedSite.Name}" />

                    <Button
                        Width="120"
                        Height="36"
                        Margin="20,0,0,0"
                        Click="Publish_Click"
                        Content="发布"
                        Style="{StaticResource ButtonPrimary}" />

                </DockPanel>

            </Border>

            <!--  配置信息  -->
            <hc:Card
                Grid.Row="1"
                Margin="20"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="站点配置" />

                    <TextBlock
                        Margin="0,20,0,0"
                        FontSize="14"
                        Text="{Binding SelectedSite.Name, StringFormat=应用池：{0}}" />

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="14"
                        Text="{Binding SelectedSite.SitePath, StringFormat=站点目录：{0}}" />

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="14"
                        Text="{Binding SelectedSite.FilePath, StringFormat=发布目录：{0}}" />

                </StackPanel>

            </hc:Card>

            <!--  日志  -->
            <hc:Card
                Grid.Row="2"
                Margin="20,0,20,0"
                Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="发布日志" />

                    <RichTextBox
                        x:Name="LogRichTextBox"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto" />

                </Grid>

            </hc:Card>

            <!--  底部  -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center">

                <ProgressBar
                    Height="26"
                    Maximum="100"
                    Value="{Binding Progress}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="{Binding ProgressText}" />

            </StackPanel>

        </Grid>

    </Grid>
</Window>