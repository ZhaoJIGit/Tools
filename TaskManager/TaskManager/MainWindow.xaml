<Window
    x:Class="TaskManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Process Manager"
    Width="980"
    Height="517"
    Loaded="Window_Loaded"
    mc:Ignorable="av">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  加载状态  -->
        <!--  遮罩层  -->
        <!--  遮罩层  -->
        <Border
            x:Name="maskBorder"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Foreground="White" Text="正在处理..." />
            </Grid>
        </Border>
        <StackPanel
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="10"
            Orientation="Horizontal">
            <TextBox
                x:Name="txtSearch"
                Width="200"
                Margin="0,0,10,0"
                VerticalAlignment="Center" />
            <Button
                Width="103"
                Click="btnFindProcesses_Click"
                Content="查找进程"
                RenderTransformOrigin="0.5,0.5" />
            <Button
                Width="103"
                Click="btnTest_Click"
                Content="Test"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Hidden" />
        </StackPanel>
        <!--  左侧 ListView  -->
        <ListView
            x:Name="lvNames"
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            MouseDoubleClick="lvNames_MouseDoubleClick"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            SelectionChanged="lvNames_SelectionChanged">
            <!--  定义右键菜单  -->
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="DeleteMenuItem_Click" Header="删除" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>

                <GridView>
                    <GridViewColumn
                        Width="160"
                        DisplayMemberBinding="{Binding TaskGroup}"
                        Header="群组" />
                </GridView>
            </ListView.View>
        </ListView>
        <ListView
            x:Name="lvProcesses"
            Grid.Row="1"
            Grid.Column="1"
            Width="auto"
            Margin="10"
            MouseDoubleClick="lvProcesses_MouseDoubleClick"
            SelectionChanged="lvProcesses_SelectionChanged"
            SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="50">
                        <GridViewColumn.Header>
                            <CheckBox
                                x:Name="chkSelectAll"
                                Checked="chkSelectAll_Checked"
                                Content="全选"
                                Unchecked="chkSelectAll_Unchecked" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding ProcessId}"
                        Header="进程ID" />
                    <GridViewColumn
                        Width="250"
                        DisplayMemberBinding="{Binding TaskGroup}"
                        Header="任务群组" />
                    <GridViewColumn
                        Width="380"
                        DisplayMemberBinding="{Binding TaskName}"
                        Header="任务名称" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="100" />

                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="10"
                    Text="{Binding Items.Count, ElementName=lvNames, StringFormat=群组数：\{0\}}" />
                <TextBlock
                    Grid.Column="2"
                    Margin="10"
                    Text="{Binding Items.Count, ElementName=lvProcesses, StringFormat=总进程数：\{0\}}" />
                <TextBlock
                    x:Name="txtExecutionTime"
                    Grid.Column="3"
                    Margin="10" />

                <Button
                    Grid.Column="8"
                    Width="80"
                    Margin="8"
                    Click="btnCloseProcess_Click"
                    Content="关闭进程" />

            </Grid>
        </StackPanel>
    </Grid>
</Window>
