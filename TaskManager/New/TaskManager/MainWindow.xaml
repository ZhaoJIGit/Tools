<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager"
        mc:Ignorable="d"
        Title="任务管理器 - 重构版" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="ListView">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
        </Style>
        
        <!-- 数据模板 -->
        <DataTemplate x:Key="TaskGroupTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TaskGroup}" FontWeight="Bold" MinWidth="150"/>
                <TextBlock Text=" (" Foreground="Gray"/>
                <TextBlock Text="{Binding ProcessCount}" Foreground="Blue"/>
                <TextBlock Text=" 个进程)" Foreground="Gray"/>
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="ProcessTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <CheckBox Grid.Column="0" 
                         IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                         VerticalAlignment="Center"
                         Margin="4 0"/>
                
                <TextBlock Grid.Column="1" 
                          Text="{Binding ProcessId}" 
                          FontWeight="Bold"
                          Foreground="DarkBlue"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding TaskName}" 
                          TextWrapping="Wrap"
                          ToolTip="{Binding TaskName}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"
                Padding="8"
                BorderThickness="0 0 0 1"
                BorderBrush="LightGray">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="搜索:" 
                          VerticalAlignment="Center"
                          Margin="8 0 4 0"/>
                
                <TextBox x:Name="txtSearch" 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Width="300"
                        VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                
                <Button Content="搜索" 
                       Command="{Binding SearchCommand}"
                       IsDefault="True"/>
                
                <Button Content="添加任务组" 
                       Command="{Binding AddTaskGroupCommand}"/>
                
                <Button Content="刷新" 
                       Command="{Binding RefreshCommand}"
                       ToolTip="刷新当前选中的任务组"/>
                
                <Separator Width="20" Visibility="Hidden"/>
                
                <Button Content="终止选中进程" 
                       Command="{Binding KillProcessCommand}"
                       Background="#FFE74C3C"
                       Foreground="White"
                       ToolTip="终止选中的进程"/>
                
                <Button Content="删除任务组" 
                       Command="{Binding DeleteTaskGroupCommand}"
                       Background="#FFE67E22"
                       Foreground="White"
                       ToolTip="删除选中的任务组"/>
                
                <Button Content="进程详情" 
                       Command="{Binding ViewProcessDetailCommand}"
                       ToolTip="查看选中进程的详细信息"/>
            </StackPanel>
        </Border>
        
        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：任务组列表 -->
            <Border Grid.Column="0" 
                    BorderThickness="0 0 1 0"
                    BorderBrush="LightGray">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" 
                              Text="任务组列表" 
                              FontSize="14"
                              FontWeight="Bold"
                              Margin="8 8 8 4"/>
                    
                    <ListView x:Name="lvTaskGroups"
                             ItemsSource="{Binding TaskGroups}"
                             SelectedItem="{Binding SelectedTaskGroup, Mode=TwoWay}"
                             ItemTemplate="{StaticResource TaskGroupTemplate}"
                             SelectionMode="Single">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="刷新" 
                                         Command="{Binding RefreshCommand}"/>
                                <Separator/>
                                <MenuItem Header="删除" 
                                         Command="{Binding DeleteTaskGroupCommand}"
                                         Foreground="Red"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </DockPanel>
            </Border>
            
            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" 
                         Width="5" 
                         HorizontalAlignment="Stretch"
                         Background="LightGray"/>
            
            <!-- 右侧：进程列表 -->
            <Border Grid.Column="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" 
                               Orientation="Horizontal"
                               Margin="8 8 8 4">
                        <TextBlock Text="进程列表" 
                                  FontSize="14"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>
                        
                        <TextBlock x:Name="txtProcessCount"
                                  Margin="8 0 0 0"
                                  VerticalAlignment="Center"
                                  Foreground="Gray">
                            <Run Text="("/>
                            <Run Text="{Binding Processes.Count}"/>
                            <Run Text=" 个进程)"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Top" 
                               Orientation="Horizontal"
                               Margin="8 0 8 4">
                        <CheckBox x:Name="chkSelectAll"
                                 Content="全选"
                                 VerticalAlignment="Center"
                                 Margin="0 0 8 0">
                            <CheckBox.Command>
                                <MultiBinding Converter="{StaticResource SelectAllConverter}">
                                    <Binding Path="Processes"/>
                                    <Binding ElementName="chkSelectAll" Path="IsChecked"/>
                                </MultiBinding>
                            </CheckBox.Command>
                        </CheckBox>
                        
                        <TextBlock Text="选中: " 
                                  VerticalAlignment="Center"
                                  Margin="8 0 4 0"/>
                        
                        <TextBlock x:Name="txtSelectedCount"
                                  Text="{Binding Processes.Count(p => p.IsSelected)}"
                                  VerticalAlignment="Center"
                                  FontWeight="Bold"
                                  Foreground="Blue"/>
                    </StackPanel>
                    
                    <ListView x:Name="lvProcesses"
                             ItemsSource="{Binding Processes}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                             ItemTemplate="{StaticResource ProcessTemplate}"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="终止进程" 
                                         Command="{Binding KillProcessCommand}"
                                         Foreground="Red"/>
                                <Separator/>
                                <MenuItem Header="查看详情" 
                                         Command="{Binding ViewProcessDetailCommand}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="选择" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="进程ID" 
                                               DisplayMemberBinding="{Binding ProcessId}"
                                               Width="80"/>
                                <GridViewColumn Header="任务组" 
                                               DisplayMemberBinding="{Binding TaskGroup}"
                                               Width="150"/>
                                <GridViewColumn Header="命令行" 
                                               DisplayMemberBinding="{Binding TaskName}"
                                               Width="400"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="2" 
                Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"
                Padding="8"
                BorderThickness="0 1 0 0"
                BorderBrush="LightGray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="{Binding StatusMessage}"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"/>
                
                <ProgressBar Grid.Column="1" 
                            Width="100"
                            Height="16"
                            IsIndeterminate="{Binding IsBusy}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
        
        <!-- 遮罩层（忙碌时显示） -->
        <Border x:Name="maskBorder"
                Grid.Row="0" 
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Border Background="White"
                        CornerRadius="8"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical"
                               HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                    Width="200"
                                    Height="8"
                                    Margin="0 0 0 12"/>
                        <TextBlock Text="处理中，请稍候..."
                                  HorizontalAlignment="Center"
                                  FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>