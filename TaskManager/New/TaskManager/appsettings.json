{
  "AppSettings": {
    "CacheSettings": {
      "Directory": "%TEMP%\\TaskManager\\Cache",
      "JsonFileName": "TaskGroup.json",
      "CacheExpirationMinutes": 30
    },
    "ProcessSettings": {
      "BatchSize": 10,
      "MaxParallelism": 4,
      "RefreshIntervalSeconds": 5,
      "MonitorDotnetOnly": true
    },
    "UiSettings": {
      "Theme": "Light",
      "ShowSystemProcesses": false,
      "AutoRefresh": true,
      "WindowLeft": 100,
      "WindowTop": 100,
      "WindowWidth": 1000,
      "WindowHeight": 700
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}